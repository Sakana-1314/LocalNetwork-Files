# systemd unit for MList.
#
#   install -Dm755 bin/mlist /usr/local/bin/mlist
#   install -Dm640 config.example.yaml /etc/mlist/config.yaml   # then edit
#   install -Dm644 deploy/mlist.service /etc/systemd/system/mlist.service
#   systemctl daemon-reload && systemctl enable --now mlist
#
# The service runs as root because the managed Samba smbd (SMB service) and the
# creation of SMB system accounts need it. If you do not use SMB you can run it
# as an unprivileged user: uncomment User=/Group= below, make sure that user
# can read/write the shared directories, and keep data_dir writable by it.

[Unit]
Description=MList (LAN file manager)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
#User=mlist
#Group=mlist
ExecStart=/usr/local/bin/mlist -config /etc/mlist/config.yaml
WorkingDirectory=/var/lib/mlist
StateDirectory=mlist
Environment=MLIST_DATA_DIR=/var/lib/mlist
Restart=on-failure
RestartSec=3
# smbd is a child process; stop it together with the server.
KillMode=mixed
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
