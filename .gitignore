# server
/server/bin/
/server/data/
/server/config.yaml
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep

# web
/web/node_modules/
/web/dist/
*.local

# docs（VitePress 站点）
/docs/node_modules/
/docs/.vitepress/dist/
/docs/.vitepress/cache/
# Demo 产物由 CI 构建（见 .github/workflows/pages.yml），不入库
/docs/public/app/

# secrets / local env
.env
server/scripts/.env

# 本地资料（机密、测试服务器、生产服务器），不得进 git
notes/

# misc
.DS_Store
.idea/
.vscode/
